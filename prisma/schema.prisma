generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

// ─────────────────────────────────────────
// HOME PAGE
// ─────────────────────────────────────────

model Slider {
  id         String   @id @default(cuid())
  titleEn    String
  titleAr    String
  subtitleEn String?
  subtitleAr String?
  ctaLabelEn String?
  ctaLabelAr String?
  ctaUrl     String?
  imageUrl   String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ExperienceNumber {
  id        String   @id @default(cuid())
  labelEn   String
  labelAr   String
  value     Int
  suffix    String?
  prefix    String?
  icon      String?
  color     String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// ABOUT
// ─────────────────────────────────────────

model AboutContent {
  id        String       @id @default(cuid())
  section   AboutSection @unique
  titleEn   String
  titleAr   String
  bodyEn    String       @db.Text
  bodyAr    String       @db.Text
  imageUrl  String?
  updatedAt DateTime     @updatedAt
}

enum AboutSection {
  OVERVIEW
  VISION
  MISSION
  IMPACT
}

model CoreValue {
  id            String  @id @default(cuid())
  titleEn       String
  titleAr       String
  descriptionEn String  @db.Text
  descriptionAr String  @db.Text
  storyEn       String? @db.Text
  storyAr       String? @db.Text
  sdgNumber     Int?
  icon          String?
  order         Int     @default(0)
  isActive      Boolean @default(true)
}

model BoardMember {
  id          String     @id @default(cuid())
  nameEn      String
  nameAr      String
  titleEn     String
  titleAr     String
  bioEn       String?    @db.Text
  bioAr       String?    @db.Text
  quoteEn     String?    @db.Text
  quoteAr     String?    @db.Text
  imageUrl    String?
  linkedinUrl String?
  twitterUrl  String?
  instagramUrl String?
  websiteUrl  String?
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  memberType  MemberType @default(BOARD)
}

enum MemberType {
  BOARD
  TEAM
  EXPERT
  MENTOR
}

model SuccessMilestone {
  id            String  @id @default(cuid())
  year          Int
  titleEn       String
  titleAr       String
  descriptionEn String? @db.Text
  descriptionAr String? @db.Text
  imageUrl      String?
  order         Int     @default(0)
}

// ─────────────────────────────────────────
// PILLARS / PROGRAMS
// ─────────────────────────────────────────

model Pillar {
  id            String       @id @default(cuid())
  slug          String       @unique
  titleEn       String
  titleAr       String
  descriptionEn String       @db.Text
  descriptionAr String       @db.Text
  iconUrl       String?
  imageUrl      String?
  order         Int          @default(0)
  isActive      Boolean      @default(true)
  subPillars    SubPillar[]
  pillarInfos   PillarInfo[]
  programs      Program[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model SubPillar {
  id       String @id @default(cuid())
  pillarId String
  pillar   Pillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  titleEn  String
  titleAr  String
  bodyEn   String @db.Text
  bodyAr   String @db.Text
  order    Int    @default(0)
}

model PillarInfo {
  id       String @id @default(cuid())
  pillarId String
  pillar   Pillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  labelEn  String
  labelAr  String
  value    String
  order    Int    @default(0)
}

// ─────────────────────────────────────────
// PROGRAMS
// ─────────────────────────────────────────

model Program {
  id            String         @id @default(cuid())
  slug          String         @unique
  titleEn       String
  titleAr       String
  summaryEn     String         @db.Text
  summaryAr     String         @db.Text
  bodyEn        String         @db.Text
  bodyAr        String         @db.Text
  coverImageUrl String?
  status        ProgramStatus  @default(ACTIVE)
  category      String?
  pillarId      String?
  pillar        Pillar?        @relation(fields: [pillarId], references: [id])
  donorEn       String?
  donorAr       String?
  locationEn    String?
  locationAr    String?
  budget        String?
  beneficiaries Int?
  year          Int?
  endYear       Int?
  startDate     DateTime?
  endDate       DateTime?
  objectivesEn  String?        @db.Text
  objectivesAr  String?        @db.Text
  images        ProgramImage[]
  teamMembers   ProgramTeamMember[]
  partners      ProgramPartner[]
  stats         ProgramStat[]
  videos        ProgramVideo[]
  isActive      Boolean        @default(true)
  isFeatured    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ProgramImage {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  order     Int     @default(0)
}

model ProgramTeamMember {
  id          String  @id @default(cuid())
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  nameEn      String
  nameAr      String
  roleEn      String
  roleAr      String
  category    String  @default("team") // "team" | "expert" | "coach"
  imageUrl    String?
  linkedinUrl String?
  order       Int     @default(0)
}

model ProgramPartner {
  id         String  @id @default(cuid())
  programId  String
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  nameEn     String
  nameAr     String
  logoUrl    String?
  websiteUrl String?
  order      Int     @default(0)
}

model ProgramStat {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  labelEn   String
  labelAr   String
  value     Int
  suffix    String?
  icon      String?
  order     Int     @default(0)
}

model ProgramVideo {
  id         String  @id @default(cuid())
  programId  String
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  titleEn    String?
  titleAr    String?
  youtubeUrl String
  order      Int     @default(0)
}

enum ProgramStatus {
  ACTIVE
  COMPLETED
  UPCOMING
}

// ─────────────────────────────────────────
// MEDIA
// ─────────────────────────────────────────

model Event {
  id              String   @id @default(cuid())
  slug            String   @unique
  titleEn         String
  titleAr         String
  summaryEn       String?  @db.Text
  summaryAr       String?  @db.Text
  descriptionEn   String   @db.Text
  descriptionAr   String   @db.Text
  imageUrl        String?
  location        String?
  locationAr      String?
  category        String?
  galleryImages   String[]
  startDate       DateTime
  endDate         DateTime?
  registrationUrl String?
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GalleryImage {
  id          String   @id @default(cuid())
  imageUrl    String
  captionEn   String?
  captionAr   String?
  albumName   String?
  albumNameAr String?
  albumSlug   String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Video {
  id           String   @id @default(cuid())
  titleEn      String
  titleAr      String
  descriptionEn String? @db.Text
  descriptionAr String? @db.Text
  youtubeUrl   String
  thumbnailUrl String?
  category     String?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Report {
  id            String   @id @default(cuid())
  titleEn       String
  titleAr       String
  descriptionEn String?  @db.Text
  descriptionAr String?  @db.Text
  fileUrl       String
  coverImageUrl String?
  category      String?
  year          Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Testimonial {
  id       String  @id @default(cuid())
  nameEn   String
  nameAr   String
  titleEn  String?
  titleAr  String?
  quoteEn  String  @db.Text
  quoteAr  String  @db.Text
  imageUrl String?
  programEn String?
  programAr String?
  category String?
  year     Int?
  isOriginalCard Boolean @default(false)
  order    Int     @default(0)
  isActive Boolean @default(true)
}

model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  titleEn       String
  titleAr       String
  summaryEn     String    @db.Text
  summaryAr     String    @db.Text
  bodyEn        String    @db.Text
  bodyAr        String    @db.Text
  coverImageUrl String?
  authorName    String?
  authorNameAr  String?
  authorRole    String?
  authorImageUrl String?
  readTimeMin   Int?
  isFeatured    Boolean   @default(false)
  category      String?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─────────────────────────────────────────
// GET INVOLVED
// ─────────────────────────────────────────

model Career {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleEn       String
  titleAr       String
  descriptionEn String   @db.Text
  descriptionAr String   @db.Text
  locationEn    String?
  locationAr    String?
  type          JobType  @default(FULL_TIME)
  deadline      DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  applications  CareerApplication[]
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VOLUNTEER
  INTERNSHIP
}

model CareerApplication {
  id          String   @id @default(cuid())
  careerId    String
  career      Career   @relation(fields: [careerId], references: [id])
  fullName    String
  email       String
  phone       String?
  resumeUrl   String?
  coverLetter String   @db.Text
  createdAt   DateTime @default(now())

  @@index([careerId])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// PARTNERS
// ─────────────────────────────────────────

model Partner {
  id         String      @id @default(cuid())
  nameEn     String
  nameAr     String
  logoUrl    String
  websiteUrl String?
  type       PartnerType @default(PARTNER)
  order      Int         @default(0)
  isActive   Boolean     @default(true)
}

enum PartnerType {
  PARTNER
  CLIENT
  DONOR
  CRISIS_PARTNER
}

// ─────────────────────────────────────────
// CONTACT / SITE CONFIG
// ─────────────────────────────────────────

model ContactInfo {
  id        String   @id @default(cuid())
  key       String   @unique
  valueEn   String
  valueAr   String?
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// LEBANON CRISIS
// ─────────────────────────────────────────

model CrisisStat {
  id      String  @id @default(cuid())
  labelEn String
  labelAr String
  value   String
  icon    String?
  order   Int     @default(0)
}

model CrisisIntervention {
  id            String @id @default(cuid())
  titleEn       String
  titleAr       String
  descriptionEn String @db.Text
  descriptionAr String @db.Text
  icon          String?
  order         Int    @default(0)
}

// ─────────────────────────────────────────
// FORM SUBMISSIONS
// ─────────────────────────────────────────

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model JoinUsSubmission {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  nationality  String?
  organization String?
  role         String?
  sector       String?
  experience   String?  @db.Text
  interestArea String?
  motivation   String?  @db.Text
  cvUrl        String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ServiceRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  organization String?
  serviceType String?
  description String   @db.Text
  budget      String?
  timeline    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum TestimonialSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model TestimonialSubmission {
  id           String  @id @default(cuid())

  // Step 1 — publishable testimonial
  fullName     String
  email        String   // internal only — never published
  phone        String?  // internal only — never published
  businessName String?
  governorate  String?
  program      String?
  quote        String  @db.Text
  locale       String   // "en" | "ar" — language the beneficiary wrote in
  consent      Boolean @default(false)
  consentTextVersion String?
  photoUrl     String?

  // Step 2 — internal impact survey (all optional)
  motivation         String? @db.Text
  challenges         String? @db.Text
  skillsGained       String? @db.Text
  valuableLesson     String? @db.Text
  lifeImpact         String? @db.Text
  results            String? @db.Text
  successStory       String? @db.Text
  adviceToOthers     String? @db.Text
  additionalComments String? @db.Text

  // Moderation
  status                 TestimonialSubmissionStatus @default(PENDING)
  publishedTestimonialId String?
  isRead                 Boolean   @default(false)
  reviewedAt             DateTime?
  createdAt              DateTime  @default(now())
}

enum BookDonationStatus {
  NEW
  NEEDS_FOLLOW_UP
  DROP_OFF_EXPECTED
  PICKUP_TO_SCHEDULE
  SCHEDULED
  COLLECTED
  RECEIVED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  CLOSED
}

model BookDonationSubmission {
  id                     String             @id @default(cuid())
  reference              String             @unique
  fullName               String
  phone                  String
  email                  String?
  governorate            String
  area                   String
  detailedAddress        String?
  estimatedQuantity      String
  bookCategories         String[]
  otherCategory          String?
  bookLanguages          String[]
  overallCondition       String
  handoverMethod         String
  photoUrls              String[]
  notes                  String?            @db.Text
  locale                 String
  donationConsent        Boolean            @default(false)
  privacyConsent         Boolean            @default(false)
  acceptanceAcknowledged Boolean            @default(false)
  consentTextVersion     String
  status                 BookDonationStatus @default(NEW)
  isRead                 Boolean            @default(false)
  adminNotes             String?            @db.Text
  reviewedAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// TEAM SELF-SERVICE ONBOARDING
// ─────────────────────────────────────────

model TeamSubmission {
  id           String  @id @default(cuid())

  // What the member submits (single language)
  name         String
  title        String
  locale       String   // "en" | "ar" — language they wrote in
  photoUrl     String?
  linkedinUrl  String?
  twitterUrl   String?
  instagramUrl String?
  websiteUrl   String?

  // Moderation
  status           TeamSubmissionStatus @default(PENDING)
  approvedMemberId String?              // BoardMember.id once approved
  isRead           Boolean   @default(false)
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
}

enum TeamSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model TeamInviteLink {
  id        String   @id            // always "singleton" — enforces one row
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// EXPERT APPLICATIONS (intake — internal data collection only)
// ─────────────────────────────────────────

model ExpertSubmission {
  id                 String  @id @default(cuid())

  // Section 1 — Personal information
  fullName           String
  professionalTitle  String
  countries          String[]
  phone              String
  email              String
  linkedinUrl        String?
  photoUrl           String?
  photoConsent       Boolean @default(false)

  // Section 2 — Academic degrees
  degrees            String[]
  degreeDetails      String  @db.Text
  majorFieldOfStudy  String

  // Section 3 — Professional experience & credentials
  yearsExperience    String
  certifications     String  @db.Text
  licensesMemberships String? @db.Text

  // Section 4 — Area of expertise
  shortBio           String  @db.Text
  expertiseKeywords  String
  notableWork        String? @db.Text
  languages          String

  // Section 5 — Publishing consent & availability
  availableForEngagements String
  dailyRate          String
  publishConsent     Boolean @default(false)

  // Moderation / management
  status             ExpertSubmissionStatus @default(NEW)
  isRead             Boolean   @default(false)
  adminNotes         String?   @db.Text
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
}

enum ExpertSubmissionStatus {
  NEW
  SHORTLISTED
  CONTACTED
  ARCHIVED
  REJECTED
}

// ─────────────────────────────────────────
// NEWSLETTER
// ─────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("en")
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────
// NEWSLETTER TOOL (Campaigns)
// ─────────────────────────────────────────

enum ContactStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  COMPLAINED
}

enum CampaignLocale {
  EN
  AR
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
}

enum CampaignEventType {
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
}

model Contact {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  tags      String[]
  status    ContactStatus @default(SUBSCRIBED)
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Suppression {
  id        String            @id @default(cuid())
  email     String            @unique
  reason    SuppressionReason
  createdAt DateTime          @default(now())
}

model Campaign {
  id             String              @id @default(cuid())
  subject        String
  html           String              @db.Text
  locale         CampaignLocale      @default(EN)
  targetTags     String[]
  recipientCount Int                 @default(0)
  status         CampaignStatus      @default(DRAFT)
  lastTestedAt   DateTime?
  enqueuedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  recipients     CampaignRecipient[]
  events         CampaignEvent[]
}

model CampaignRecipient {
  id                String          @id @default(cuid())
  campaignId        String
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email             String
  name              String?
  unsubToken        String          @unique
  batchIndex        Int
  status            RecipientStatus @default(PENDING)
  attempts          Int             @default(0)
  error             String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime        @default(now())

  @@unique([campaignId, email])
  @@index([campaignId, status])
}

model CampaignEvent {
  id              String            @id @default(cuid())
  campaignId      String
  campaign        Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type            CampaignEventType
  email           String
  providerEventId String?           @unique
  occurredAt      DateTime
  createdAt       DateTime          @default(now())

  @@index([campaignId, type])
}
