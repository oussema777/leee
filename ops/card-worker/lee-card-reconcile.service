[Unit]
Description=LEE card payment recovery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/lee-whish-worker.env
ExecStart=/usr/bin/python3 /opt/lee-card/reconcile.py
TimeoutStartSec=145
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
