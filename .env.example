# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Authentication
JWT_SECRET="generate-a-strong-random-secret-here"

# Site URL (set to your Vercel domain in production)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Storage — required for image/file uploads in the admin dashboard.
# Find both in the Supabase dashboard: Project Settings → API.
# Without these, uploads fail with "supabaseUrl is required".
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Email notifications (Resend) — form/application submissions email the team.
# If RESEND_API_KEY is unset, submissions still work; notifications are skipped.
RESEND_API_KEY=""
EMAIL_FROM="The LEE Experience <noreply@theleeexperience.com>"
EMAIL_TO="info@theleeexperience.com"

# Newsletter tool — internal admin newsletter sending (Contacts → Campaigns).
# NEWSLETTER_FROM/REPLY_TO: the sender shown on newsletters (must be a Resend-verified domain).
# NEWSLETTER_UNSUB_SECRET / CRON_SECRET / RESEND_WEBHOOK_SECRET: random 32+ char hex (openssl rand -hex 32).
NEWSLETTER_FROM="The LEE Experience <newsletter@theleeexperience.com>"
NEWSLETTER_REPLY_TO="info@theleeexperience.com"
NEWSLETTER_UNSUB_SECRET=""      # HMAC secret for unsubscribe tokens
RESEND_WEBHOOK_SECRET=""        # Resend webhook signing secret
CRON_SECRET=""                  # shared secret authorizing the Vercel Cron drainer
NEWSLETTER_BATCH_SIZE="100"     # recipients per Resend batch call (confirm Resend's cap)
