# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Authentication
JWT_SECRET="generate-a-strong-random-secret-here"

# Site URL (set to your Vercel domain in production)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email notifications (Resend) — form/application submissions email the team.
# If RESEND_API_KEY is unset, submissions still work; notifications are skipped.
RESEND_API_KEY=""
EMAIL_FROM="The LEE Experience <noreply@theleeexperience.com>"
EMAIL_TO="info@theleeexperience.com"
