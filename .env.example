# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Authentication
JWT_SECRET="generate-a-strong-random-secret-here"
# Optional separate secret for ebook email-code hashing (32+ characters).
# Falls back to JWT_SECRET when omitted. Reader sessions are stored separately.
EBOOK_AUTH_SECRET=""
# Set to 1 in isolated test/preview environments to prevent outbound ebook emails.
EBOOK_DISABLE_EMAIL="0"

# Site URL (set to your Vercel domain in production)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Storage — required for image/file uploads in the admin dashboard.
# Find both in the Supabase dashboard: Project Settings → API.
# Without these, uploads fail with "supabaseUrl is required".
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Email notifications (Resend) — form/application submissions email the team.
# If RESEND_API_KEY is unset, submissions still work; notifications are skipped.
RESEND_API_KEY=""
EMAIL_FROM="The LEE Experience <noreply@theleeexperience.com>"
EMAIL_TO="info@theleeexperience.com"

# Newsletter tool — internal admin newsletter sending (Contacts → Campaigns).
# NEWSLETTER_FROM/REPLY_TO: the sender shown on newsletters (must be a Resend-verified domain).
# NEWSLETTER_UNSUB_SECRET / CRON_SECRET / RESEND_WEBHOOK_SECRET: random 32+ char hex (openssl rand -hex 32).
NEWSLETTER_FROM="The LEE Experience <newsletter@theleeexperience.com>"
NEWSLETTER_REPLY_TO="info@theleeexperience.com"
NEWSLETTER_UNSUB_SECRET=""      # HMAC secret for unsubscribe tokens
RESEND_WEBHOOK_SECRET=""        # Resend webhook signing secret
CRON_SECRET=""                  # shared secret authorizing the Vercel Cron drainer
NEWSLETTER_BATCH_SIZE="100"     # recipients per Resend batch call (confirm Resend's cap)

# Aramex shipping account - server-side only; keep real values in .env.local.
# Verify tracking with: npm run aramex:check -- <existing-tracking-number>
# Draft storage and submission safeguards are implemented; real sending is disabled.
# Credentials alone cannot enable sending. UAT uses the authenticated VPS gateway.
# The check script above targets PRODUCTION tracking, not UAT.
# Escape literal dollar signs as \$.
ARAMEX_USERNAME=""
ARAMEX_PASSWORD=""
ARAMEX_ACCOUNT_NUMBER=""
ARAMEX_ACCOUNT_PIN=""
ARAMEX_ACCOUNT_ENTITY=""
ARAMEX_ACCOUNT_COUNTRY_CODE=""

# UAT tracking receiver: configure only after agreeing the webhook secret/header and retries.
# Does not enable shipment creation. Keep false until the tracking migration is installed.
ARAMEX_UAT_TRACKING_ENABLED=false
ARAMEX_UAT_WEBHOOK_KEY=

# Manual full-history tracking lookup; never falls back to production credentials.
# Enable only after UAT account and outbound IP verification.
ARAMEX_UAT_LOOKUP_ENABLED=false
ARAMEX_UAT_USERNAME=
ARAMEX_UAT_PASSWORD=
ARAMEX_UAT_ACCOUNT_NUMBER=
ARAMEX_UAT_ACCOUNT_PIN=
ARAMEX_UAT_ACCOUNT_ENTITY=
ARAMEX_UAT_ACCOUNT_COUNTRY_CODE=
ARAMEX_UAT_VERSION=

# PrintLabel for existing UAT shipments; confirm these account settings first.
ARAMEX_UAT_LABEL_ENABLED=false
ARAMEX_UAT_ORIGIN_ENTITY=
ARAMEX_UAT_LABEL_REPORT_ID=

# UAT booking route only; keep off until account, egress and service settings are verified.
ARAMEX_UAT_SUBMISSION_ENABLED=false
# Strict ShipmentSettings JSON; no credentials, URLs or guessed account defaults.
ARAMEX_UAT_SHIPMENT_SETTINGS_JSON=

# Required for all outbound UAT operations; no direct-network fallback.
ARAMEX_UAT_GATEWAY_URL=https://aramex-gateway.theleeexperience.com
# Server-only secret generated on the VPS; never prefix with NEXT_PUBLIC_.
ARAMEX_UAT_GATEWAY_KEY=

# Server-only Areeba / Bank Audi sandbox credentials; never NEXT_PUBLIC_.
CYBERSOURCE_TEST_MERCHANT_ID=
CYBERSOURCE_TEST_KEY_ID=
CYBERSOURCE_TEST_SECRET_KEY=
# Staff-only testing, after installing the payment-attempt table.
# Requires the approved www origin and JWT_SECRET with at least 32 characters.
CYBERSOURCE_TEST_CHECKOUT_ENABLED=false

# Admin-only customer sandbox flow; never enables real payments.
CYBERSOURCE_CUSTOMER_TEST_ENABLED=false
